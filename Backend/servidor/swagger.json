{
  "swagger": "2.0",
  "info": {
    "title": "API de Social Graph Activity Feed",
    "description": "API para módulo de feed de actividad social estilo Letterboxd, desarrollado con Node.js, Express y MongoDB. Permite a los usuarios seguirse entre sí, comentar, dar likes y ver las actividades de sus seguidores",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "tags": [
    { "name": "Health", "description": "Estado del servicio" },
    { "name": "Auth", "description": "Autenticación y sesión" },
    { "name": "Users", "description": "Usuarios y perfiles" },
    { "name": "Follow", "description": "Seguimientos, seguidos y seguidores" },
    { "name": "Feed", "description": "Feed de actividad" },
    { "name": "Likes", "description": "Reacciones de me gusta" },
    { "name": "Comments", "description": "Comentarios en publicaciones" },
    { "name": "Publications", "description": "Publicaciones y reseñas" },
    { "name": "Movies", "description": "Películas" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck",
        "description": "Devuelve 200 si el servicio está operativo",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "description": "Autentica un usuario y retorna tokens de acceso",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["username", "password"],
              "properties": {
                "username": { "type": "string", "example": "any" },
                "password": { "type": "string", "example": "any" },
                "grant_type": { "type": "string", "example": "password" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refrescar token",
        "description": "Recibe un refresh_token y entrega un nuevo access_token",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["refresh_token"],
              "properties": {
                "refresh_token": { "type": "string", "example": "any" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Usuario actual",
        "description": "Obtiene la información del usuario autenticado",
        "parameters": [
          { "name": "authorization", "in": "header", "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/follow": {
      "post": {
        "tags": ["Follow"],
        "summary": "Seguir usuario",
        "description": "Genera una relación de seguimiento entre usuarios",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["follower_user_id", "followed_user_id"],
              "properties": {
                "follower_user_id": { "type": "string", "example": "any" },
                "followed_user_id": { "type": "string", "example": "any" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/unfollow": {
      "post": {
        "tags": ["Follow"],
        "summary": "Dejar de seguir",
        "description": "Elimina una relación de seguimiento",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["follower_user_id", "followed_user_id"],
              "properties": {
                "follower_user_id": { "type": "string", "example": "any" },
                "followed_user_id": { "type": "string", "example": "any" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/feed": {
      "get": {
        "tags": ["Feed"],
        "summary": "Feed de actividades",
        "description": "Devuelve actividades de los usuarios seguidos",
        "parameters": [
          { "name": "page", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "string" },
          { "name": "user_id", "in": "query", "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/followed": {
      "get": {
        "tags": ["Follow"],
        "summary": "Usuarios seguidos",
        "description": "Lista de usuarios a los que un usuario sigue",
        "parameters": [
          { "name": "page", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "string" },
          { "name": "user_id", "in": "query", "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/followers": {
      "get": {
        "tags": ["Follow"],
        "summary": "Seguidores",
        "description": "Lista de usuarios que siguen a un usuario",
        "parameters": [
          { "name": "page", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "string" },
          { "name": "user_id", "in": "query", "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/like": {
      "post": {
        "tags": ["Likes"],
        "summary": "Dar like",
        "description": "Crea una reacción de like sobre una publicación",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["user_id", "target_id", "target_type"],
              "properties": {
                "user_id": { "type": "string", "example": "any" },
                "target_id": { "type": "string", "example": "any" },
                "target_type": { "type": "string", "example": "publication" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/like/{like_id}": {
      "delete": {
        "tags": ["Likes"],
        "summary": "Quitar like",
        "description": "Elimina una reacción de like por ID",
        "parameters": [
          { "name": "like_id", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": { "user_id": { "type": "string", "example": "any" } }
            }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/like/publication/{publication_id}": {
      "get": {
        "tags": ["Likes"],
        "summary": "Likes de una publicación",
        "description": "Lista de likes para una publicación",
        "parameters": [
          { "name": "publication_id", "in": "path", "required": true, "type": "string" },
          { "name": "page", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
