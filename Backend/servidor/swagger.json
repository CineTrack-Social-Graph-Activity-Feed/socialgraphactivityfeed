        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/publication": {
      "post": {
        "tags": ["Publications"],
        "summary": "Crear publicación",
        "description": "Crea una publicación/reseña",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "author_id": { "example": "any" },
                "type": { "example": "review" },
                "target_id": { "example": "any" },
                "content": { "example": "any" },
                "rating": { "example": 5 },
                "title": { "example": "any" },
                "has_spoilers": { "example": false },
                "tags": { "example": ["drama", "cine"] }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
