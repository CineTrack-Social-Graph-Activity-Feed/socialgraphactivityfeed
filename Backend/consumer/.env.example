# ============================================
# CONFIGURACIÓN ESENCIAL
# ============================================

# MongoDB - Tu base de datos
MONGO_URI=mongodb+srv://nicolasaversa1_db_user:4mSvF4VaOswSKngJ@socialgraph-activityfee.reute35.mongodb.net/?retryWrites=true&w=majority&appName=SocialGraph-ActivityFeed

# RabbitMQ - URL del Core
RABBIT_URL=amqps://root:argentina10.@b-0a4abdb3-2999-4dab-aada-d69982950fa5.mq.us-east-2.on.aws:5671

# Routing Keys que escuchas (incluye usuarios, reseñas y películas)
ROUTING_KEYS=usuarios.usuario.creado, usuarios.sesion.iniciada, usuarios.sesion.finalizada, resenas.resena.creada, resenas.resena.actualizada, resenas.resena.eliminada, peliculas.pelicula.creada, peliculas.pelicula.actualizada, peliculas.pelicula.borrada, usuarios.usuario.eliminado, usuarios.usuario.actualizado, usuarios.usuario.reactivado

# ============================================
# CONFIGURACIÓN AVANZADA (OPCIONAL)
# Las siguientes variables tienen valores por defecto.
# Solo necesitas cambiarlas si el Core usa otros valores.
# ============================================

# Nombre de tu Queue (por defecto: "social_graph_queue")
# QUEUE_NAME=core.social.queue

# Nombre del exchange (por defecto: letterboxd_exchange)
# EXCHANGE_NAME=letterboxd_exchange


# Routing Keys que escuchas (comodín por defecto)
# ROUTING_KEYS=usuarios.#,resenas.#,peliculas.#

# ===============================
# Reglas de borrado en cascada
# ===============================
# Cuando se reciba peliculas.pelicula.borrada, eliminar publicaciones de esa película
# Valores: true/false (por defecto: true)
PUBLICATION_CASCADE_ON_MOVIE_DELETE=true

# Modo de borrado de publicaciones: "soft" (marca isDeleted) o "hard" (deleteMany)
# Por defecto: soft
PUBLICATION_CASCADE_MODE=soft

# Puerto del servicio (por defecto: 3001)
# PORT=3001

# Entorno (por defecto: development)
# NODE_ENV=development

# Reintentos de conexión (por defecto: 10)
# MAX_RECONNECT_ATTEMPTS=10

# Intervalo entre reintentos en ms (por defecto: 5000)
# RECONNECT_INTERVAL=5000
